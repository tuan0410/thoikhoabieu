{
  "name": "lichhoc-mobile", "version": "0.1.0", "private": true,
  "scripts": {
    "build": "node ../scripts/build-mobile.cjs",
    "add:android": "npm run build && cap add android && cap sync android",
    "add:ios": "npm run build && cap add ios && cap sync ios",
    "sync": "npm run build && cap sync",
    "open:android": "cap open android", "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.0.0", "@capacitor/android": "8.0.0", "@capacitor/ios": "8.0.0",
    "lichhoc-portal": "file:./portal"
  },
  "devDependencies": { "@capacitor/cli": "8.0.0", "esbuild": "0.25.12" }
}
